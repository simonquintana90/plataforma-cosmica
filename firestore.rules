rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is the admin
    function isAdmin() {
      return request.auth != null && request.auth.uid == "SFYFi9u8uZYJHSNEEyGQaigIyip1";
    }

    // Helper function to check if the user is accessing their own document
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Admin can read/write everything
      // Owner can read/write their own document
      // DEBUG: Allow all authenticated users to read/write for now to test
      allow read, write: if request.auth != null;
      
      // Payments subcollection
      match /payments/{paymentId} {
        allow read: if isAdmin() || isOwner(userId);
        // Payments are created via backend functions mostly, but allow write if needed for testing or specific admin overrides
        allow write: if isAdmin();
      }

      // Landing Pages subcollection
      match /landingPages/{pageId} {
          allow read, write: if isAdmin() || isOwner(userId);
      }

      // Monthly Analytics subcollection
      match /analytics_monthly/{monthId} {
          allow read: if isAdmin() || isOwner(userId);
      }

      // Recordings subcollection
      match /recordings/{recordingId} {
          allow read, write: if isAdmin() || isOwner(userId);
          
          // Chunks for recordings
          match /chunks/{chunkId} {
              allow read, write: if isAdmin() || isOwner(userId);
          }
      }
    }

    // Requests collection
    match /requests/{requestId} {
      // Admin can read/write everything
      // Owner can create requests and read their own requests
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      
      // Messages subcollection
      match /messages/{messageId} {
         allow read, write: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/requests/$(requestId)).data.userId == request.auth.uid);
      }
      // Messages subcollection
      match /messages/{messageId} {
         allow read, write: if isAdmin() || (request.auth != null && get(/databases/$(database)/documents/requests/$(requestId)).data.userId == request.auth.uid);
      }
    }

    // Payouts collection
    match /payouts/{payoutId} {
      allow read, create: if isAdmin() || (request.auth != null && resource.data.userId == request.auth.uid);
      // Allow create if the userId in the data matches the auth uid
       allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
    }

    // Coupons collection
    match /coupons/{couponId} {
        allow read, write: if isAdmin();
    }
  }
}
